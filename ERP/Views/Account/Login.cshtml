@model ERP.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login - BITWARE ERP";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>BITWARE ERP | Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --bit-teal: #0E7A8A;
            --bit-teal-deep: #0A5F6B;
            --bit-teal-soft: #E6F0F1;
            --bit-paper: #F8F7F4;
            --bit-surface: #FFFFFF;
            --bit-ink: #1A1D23;
            --bit-ink-soft: #5A5F6A;
            --bit-line: #E8E6E1;
            --bit-sidebar: #111318;
            --bit-sidebar-2: #1C1F26;
        }

        * {
            font-family: 'Instrument Sans',system-ui,sans-serif;
            box-sizing: border-box;
            -webkit-font-smoothing: antialiased;
        }

        body {
            margin: 0;
            background: var(--bit-paper);
            color: var(--bit-ink);
            height: 100vh;
            overflow: hidden;
            display: flex;
        }

        /* LEFT - BRAND PANEL */
        .left {
            width: 46%;
            background: var(--bit-sidebar);
            position: relative;
            padding: 48px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            background-image: radial-gradient(circle at 20% 30%, rgba(14,122,138,0.25), transparent 40%), radial-gradient(circle at 80% 80%, rgba(14,122,138,0.15), transparent 50%);
        }

        .left-top {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .logo-icon {
            width: 42px;
            height: 42px;
            background: var(--bit-surface);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--bit-teal);
            font-weight: 800;
            font-size: 18px;
            letter-spacing: -1px;
        }

        .logo-text b {
            font-size: 22px;
            color: #fff;
            letter-spacing: -0.02em;
            display: block;
            line-height: 1;
        }

            .logo-text b span {
                color: var(--bit-teal);
            }

        .logo-text small {
            font-size: 9px;
            letter-spacing: 0.22em;
            color: #6B7280;
            font-weight: 700;
            margin-top: 4px;
            display: block;
        }

        .left-center {
            margin-top: 20px;
        }

            .left-center h1 {
                font-size: 44px;
                line-height: 0.95;
                letter-spacing: -0.04em;
                color: #fff;
                font-weight: 700;
                margin: 0;
            }

                .left-center h1 i {
                    color: var(--bit-teal);
                    font-style: normal;
                }

            .left-center p {
                color: #9CA3AF;
                font-size: 14.5px;
                line-height: 1.6;
                margin-top: 18px;
                max-width: 420px;
            }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,0.06);
            border: 1px solid #252932;
            color: #9CA3AF;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 11px;
            font-family: 'JetBrains Mono',monospace;
            margin-bottom: 18px;
        }

            .pill .dot {
                width: 6px;
                height: 6px;
                background: var(--bit-teal);
                border-radius: 50%;
                box-shadow: 0 0 0 4px rgba(14,122,138,0.2);
            }

        .left-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 36px;
        }

        .stat {
            background: var(--bit-sidebar-2);
            border: 1px solid #252932;
            border-radius: 16px;
            padding: 16px;
        }

            .stat b {
                color: #fff;
                font-size: 22px;
                display: block;
                font-weight: 700;
                letter-spacing: -0.02em;
            }

            .stat span {
                font-size: 11px;
                color: #6B7280;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                font-weight: 700;
                margin-top: 4px;
                display: block;
            }

        .left-bottom {
            font-size: 11px;
            color: #4B5563;
            font-family: 'JetBrains Mono',monospace;
            display: flex;
            justify-content: space-between;
        }

        /* RIGHT - FORM PANEL */
        .right {
            flex: 1;
            background: var(--bit-surface);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 24px;
        }

            .right::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 1px;
                background: var(--bit-line);
            }

        .form-wrap {
            width: 100%;
            max-width: 400px;
            animation: rise .6s cubic-bezier(.16,1,.3,1);
        }

        @@keyframes rise {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-head h2 {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin: 0;
        }

        .form-head p {
            font-size: 13.5px;
            color: var(--bit-ink-soft);
            margin: 6px 0 28px;
            line-height: 1.5;
        }

        .error-box {
            background: #FEF2F2;
            border: 1px solid #FECACA;
            color: #991B1B;
            padding: 12px 14px;
            border-radius: 12px;
            font-size: 12.5px;
            margin-bottom: 16px;
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }

            .error-box i {
                margin-top: 1px;
            }

        .field {
            margin-bottom: 16px;
        }

            .field label {
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: var(--bit-ink-soft);
                display: block;
                margin-bottom: 8px;
            }

        .input-wrap {
            position: relative;
            display: flex;
            align-items: center;
            background: var(--bit-paper);
            border: 1px solid var(--bit-line);
            border-radius: 12px;
            height: 46px;
            padding: 0 14px;
            transition: all .2s cubic-bezier(.16,1,.3,1);
        }

            .input-wrap:focus-within {
                border-color: var(--bit-ink);
                background: var(--bit-surface);
                box-shadow: 0 0 0 4px var(--bit-teal-soft);
            }

            .input-wrap i {
                color: var(--bit-ink-soft);
                font-size: 13px;
                width: 20px;
            }

            .input-wrap input {
                border: none;
                background: transparent;
                outline: none;
                width: 100%;
                font-size: 14px;
                color: var(--bit-ink);
                margin-left: 8px;
            }

                .input-wrap input::placeholder {
                    color: #9CA3AF;
                }

        .row-between {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 16px 0 24px;
        }

        .check {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--bit-ink-soft);
            cursor: pointer;
        }

            .check input {
                width: 16px;
                height: 16px;
                accent-color: var(--bit-teal);
            }

        .btn-login {
            width: 100%;
            height: 48px;
            border-radius: 12px;
            border: none;
            background: var(--bit-ink);
            color: #fff;
            font-weight: 600;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            cursor: pointer;
            transition: all .2s;
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        }

            .btn-login:hover {
                background: var(--bit-sidebar);
                transform: translateY(-1px);
                box-shadow: 0 12px 24px rgba(0,0,0,0.16);
            }

            .btn-login:active {
                transform: translateY(0) scale(.99);
            }

            .btn-login .arrow {
                width: 22px;
                height: 22px;
                background: var(--bit-teal);
                border-radius: 999px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 11px;
            }

        .foot {
            margin-top: 28px;
            text-align: center;
            font-size: 11px;
            color: #9CA3AF;
            font-family: 'JetBrains Mono',monospace;
            line-height: 1.6;
        }

            .foot b {
                color: var(--bit-ink-soft);
                font-weight: 600;
            }

        @@media (max-width: 980px) {
            .left {
                display: none;
            }

            .right {
                padding: 20px;
            }

            body {
                overflow: auto;
                height: auto;
                min-height: 100vh;
            }
        }
    </style>
</head>
<body>

    <div class="left">
        <div>
            <div class="left-top">
                <div class="logo-icon">B</div>
                <div class="logo-text">
                    <b>BITWARE <span>ERP</span></b>
                    <small>ENTERPRISE OS • 2026</small>
                </div>
            </div>

            <div class="left-center">
                <div class="pill"><span class="dot"></span> SYSTEM ONLINE • MHS-SERVER</div>
                <h1>Manage<br>everything<br><i>like a pro.</i></h1>
                <p>OldMoney edition — real-time sugar inventory, cane, finance and HR. Built for Habib Sugar Mills and enterprise teams who need speed without noise.</p>

                <div class="left-stats">
                    <div class="stat"><b>99.9%</b><span>Uptime SLA</span></div>
                    <div class="stat"><b>2223</b><span>Active Modules</span></div>
                </div>
            </div>
        </div>

        <div class="left-bottom">
            <span>© 2026 Bitware Software Solution</span>
            <span>v1.0 • EnterpriseSuiteCore</span>
        </div>
    </div>

    <div class="right">
        <div class="form-wrap">
            <div class="form-head">
                <h2>Welcome back</h2>
                <p>Sign in to your Bitware account. Your session is secured with ASP.NET Membership.</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="error-box"><i class="fa-solid fa-circle-exclamation"></i><span>@Model.ErrorMessage</span></div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-box">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>
                        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@e.ErrorMessage</div>
                        }
                    </span>
                </div>
            }

            <form asp-action="Login" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="field">
                    <label>Username</label>
                    <div class="input-wrap">
                        <i class="fa-regular fa-user"></i>
                        <input asp-for="UserName" placeholder="e.g. admin.habib" autofocus autocomplete="username" />
                    </div>
                </div>

                <div class="field">
                    <label>Password</label>
                    <div class="input-wrap">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="Password" type="password" placeholder="••••••••" autocomplete="current-password" />
                    </div>
                </div>

                <div class="row-between">
                    <label class="check">
                        <input asp-for="RememberMe" type="checkbox" /> Remember me
                    </label>
                    <a href="#" style="font-size:12px; color:var(--bit-teal); text-decoration:none; font-weight:600;">Forgot password?</a>
                </div>

                <button type="submit" class="btn-login">
                    Sign In <span class="arrow"><i class="fa-solid fa-arrow-right"></i></span>
                </button>
            </form>

            <div class="foot">
                Secure login via <b>aspnet_Membership</b> • SHA1 + Salt<br>
                Press <b>/</b> to focus • EnterpriseSuiteCore v1.0
            </div>
        </div>
    </div>

</body>
</html>