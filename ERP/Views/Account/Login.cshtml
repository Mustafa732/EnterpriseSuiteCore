@model ERP.Models.LoginViewModel
@{
    Layout = null;
    var companyName = Model.CompanyName ?? "BITWARE ERP SYSTEM";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@companyName - Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --bit-teal: #0E7A8A;
            --bit-teal-soft: #E6F0F1;
            --bit-paper: #F8F7F4;
            --bit-surface: #FFFFFF;
            --bit-ink: #1A1D23;
            --bit-ink-soft: #5A5F6A;
            --bit-line: #E8E6E1;
            --bit-sidebar: #111318;
            --bit-sidebar-2: #1C1F26;
        }

        * {
            font-family: 'Instrument Sans',system-ui,sans-serif;
            box-sizing: border-box;
            -webkit-font-smoothing: antialiased;
        }

        body {
            margin: 0;
            background: var(--bit-surface);
            color: var(--bit-ink);
            height: 100vh;
            overflow: hidden;
            display: flex;
        }

        .left {
            width: 52%;
            background: var(--bit-sidebar);
            padding: 56px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            background-image: radial-gradient(circle at 20% 30%, rgba(14,122,138,0.22), transparent 45%), radial-gradient(circle at 85% 85%, rgba(14,122,138,0.14), transparent 50%);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .logo {
            width: 44px;
            height: 44px;
            background: #fff;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--bit-teal);
            font-weight: 800;
            font-size: 18px;
        }

        .brand b {
            font-size: 18px;
            color: #fff;
            letter-spacing: -0.02em;
            line-height: 1;
            display: block;
        }

        .brand small {
            font-size: 10px;
            letter-spacing: 0.18em;
            color: #6B7280;
            font-weight: 700;
            margin-top: 4px;
            display: block;
        }

        .left-content h1 {
            font-size: 52px;
            line-height: 0.92;
            letter-spacing: -0.05em;
            color: #fff;
            font-weight: 700;
            margin: 0;
        }

            .left-content h1 span {
                color: var(--bit-teal);
            }

        .left-content p {
            color: #9CA3AF;
            font-size: 15px;
            line-height: 1.7;
            margin-top: 20px;
            max-width: 420px;
        }

        .left-bottom {
            font-size: 11px;
            color: #4B5563;
            font-family: 'JetBrains Mono',monospace;
        }

        .right {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px;
            background: var(--bit-surface);
        }

        .form-wrap {
            width: 100%;
            max-width: 380px;
            animation: rise .5s cubic-bezier(.16,1,.3,1);
        }

        @@keyframes rise {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-head h2 {
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin: 0;
        }

        .form-head p {
            font-size: 14px;
            color: var(--bit-ink-soft);
            margin: 8px 0 32px;
            line-height: 1.5;
        }

        .error-box {
            background: #FEF2F2;
            border: 1px solid #FECACA;
            color: #991B1B;
            padding: 12px 14px;
            border-radius: 12px;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .field {
            margin-bottom: 18px;
        }

            .field label {
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: var(--bit-ink-soft);
                display: block;
                margin-bottom: 8px;
            }

        .input-wrap {
            display: flex;
            align-items: center;
            background: var(--bit-paper);
            border: 1px solid var(--bit-line);
            border-radius: 12px;
            height: 48px;
            padding: 0 14px;
            transition: all .2s;
        }

            .input-wrap:focus-within {
                border-color: var(--bit-ink);
                background: #fff;
                box-shadow: 0 0 0 4px var(--bit-teal-soft);
            }

            .input-wrap i {
                color: #9CA3AF;
                font-size: 14px;
                width: 20px;
            }

            .input-wrap input {
                border: none;
                background: transparent;
                outline: none;
                width: 100%;
                font-size: 14px;
                color: var(--bit-ink);
                margin-left: 8px;
            }

                .input-wrap input::placeholder {
                    color: #9CA3AF;
                }

        .row-between {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 18px 0 28px;
        }

        .check {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--bit-ink-soft);
            cursor: pointer;
        }

            .check input {
                width: 16px;
                height: 16px;
                accent-color: var(--bit-teal);
            }

        .btn-login {
            width: 100%;
            height: 48px;
            border-radius: 12px;
            border: none;
            background: var(--bit-ink);
            color: #fff;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all .2s;
        }

            .btn-login:hover {
                background: var(--bit-sidebar);
                transform: translateY(-1px);
            }

        .link-forgot {
            font-size: 13px;
            color: var(--bit-teal);
            text-decoration: none;
            font-weight: 600;
        }

            .link-forgot:hover {
                text-decoration: underline;
            }

        .foot {
            margin-top: 40px;
            text-align: center;
            font-size: 11px;
            color: #9CA3AF;
        }

        @@media (max-width: 900px) {
            .left {
                display: none;
            }

            body {
                overflow: auto;
                height: auto;
                min-height: 100vh;
            }
        }
    </style>
</head>
<body>

    <div class="left">
        <div class="brand">
            <div class="logo">@(string.IsNullOrEmpty(Model.LogoUrl) ? Model.CompanyName.Substring(0, 1) : "B")</div>
            <div>
                <b>@Model.CompanyName</b>
                <small>ENTERPRISE ERP</small>
            </div>
        </div>

        <div class="left-content">
            <h1>Manage<br>everything<br><span>like a pro.</span></h1>
            <p>A modern ERP for sugar mills, manufacturing and enterprise teams — fast, secure and built to scale with your business.</p>
        </div>

        <div class="left-bottom">© 2026 @Model.CompanyName. All rights reserved.</div>
    </div>

    <div class="right">
        <div class="form-wrap">
            <div class="form-head">
                <h2>Welcome back</h2>
                <p>Please sign in to your account to continue.</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="error-box">@Model.ErrorMessage</div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-box">@ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage</div>
            }

            <form asp-action="Login" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="field">
                    <label>Username</label>
                    <div class="input-wrap">
                        <i class="fa-regular fa-user"></i>
                        <input asp-for="UserName" placeholder="Enter your username" autofocus autocomplete="username" />
                    </div>
                </div>

                <div class="field">
                    <label>Password</label>
                    <div class="input-wrap">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="Password" type="password" placeholder="Enter your password" autocomplete="current-password" />
                    </div>
                </div>

                <div class="row-between">
                    <label class="check"><input asp-for="RememberMe" type="checkbox" /> Remember me</label>
                    <a href="#" class="link-forgot">Forgot password?</a>
                </div>

                <button type="submit" class="btn-login">Sign In</button>
            </form>

            <div class="foot">© 2026 @Model.CompanyName</div>
        </div>
    </div>

</body>
</html>