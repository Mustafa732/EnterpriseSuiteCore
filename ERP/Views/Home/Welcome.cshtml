@model ERP.Models.WelcomeViewModel
@{
    Layout = "~/Views/Shared/_GeneralLayout.cshtml";
    ViewData["Title"] = "Welcome - BITWARE ERP";
}

<style>
/* SAME CSS AS YOUR OLD Welcome.aspx */
.coa-item {
    display: flex;
    background: #fff;
    border-radius: 14px;
    margin-bottom: 14px;
    box-shadow: 0 3px 14px rgba(0,0,0,0.06);
    overflow: hidden;
    transition: 0.2s ease;
}
.coa-item:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0,0,0,0.12); }
.coa-accent { width: 6px; background: linear-gradient(180deg, #6366f1, #22c55e); }
.coa-content { flex: 1; padding: 14px 16px; }
.coa-top { display: flex; justify-content: space-between; align-items: flex-start; }
.coa-title { font-size: 16px; font-weight: 700; color: #111827; }
.year { font-weight: 400; color: #6b7280; }
.coa-meta { margin-top: 4px; font-size: 12px; color: #6b7280; display: flex; gap: 12px; }
.coa-tag { background: #eef2ff; color: #4f46e5; font-size: 11px; padding: 4px 10px; border-radius: 20px; font-weight: 600; }
.coa-info { display: flex; gap: 30px; margin-top: 10px; font-size: 13px; }
.coa-info .lbl { color: #9ca3af; margin-right: 5px; }
.coa-info .val { font-weight: 500; color: #111827; }
.coa-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; }
.coa-desc { font-size: 13px; color: #374151; }
.coa-btn { background: linear-gradient(135deg, #34a3b7, #237988); color: #fff; padding: 6px 14px; border-radius: 10px; text-decoration: none; font-size: 13px; transition: 0.2s; display:inline-block; }
.coa-btn:hover { transform: scale(1.05); opacity: 0.95; color:#fff; }
.unit-card-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
.unit-card { background: #f3f4f6; border: 1px solid #ddd; border-radius: 10px; padding: 20px; text-align: center; transition: 0.2s; cursor:pointer; }
.unit-card:hover { background: #45879396; color: #fff; }
.unit-card.selected { background: #2c6e74; color: #fff; border-color: #2c6e74; }
.card-link { display: block; width: 100%; text-decoration: none; color: inherit; font-weight:600; }
.erp-welcome { text-align: center; margin-bottom: 30px; font-family: "Segoe UI", Arial, sans-serif; }
.erp-welcome h1 { margin: 0 0 10px; font-size: 32px; font-weight: 700; color: #1e3a5f; }
.erp-welcome p { margin: 0; font-size: 16px; color: #64748b; }
.rs-businessType { display:flex; align-items:center; gap:12px; margin-bottom:20px; background:#fff; padding:12px 16px; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,0.05); }
.rs-businessType select { padding:8px 12px; border-radius:8px; border:1px solid #e5e7eb; min-width:250px; }
</style>

<div class="erp-welcome">
    <h1>Welcome Back!</h1>
    <p>Choose Your Company, Unit & Fiscal Year to Get Started</p>
</div>

<!-- Business Dropdown - Same as old ddlBusiness -->
<div class="rs-businessType">
    <label style="font-weight:600;">Business:</label>
    <form asp-action="ChangeBusiness" method="post" id="businessForm">
        <select name="businessId" onchange="this.form.submit()" class="form-control">
            @foreach (var b in Model.BusinessList)
            {
                if (b.BusinessId == Model.SelectedBusinessId)
                {
                    <option value="@b.BusinessId" selected>@b.BusinessName</option>
                }
                else
                {
                    <option value="@b.BusinessId">@b.BusinessName</option>
                }
            }
        </select>
    </form>
</div>

<!-- Operating Units - Cards (Old rpt_Units Repeater) -->
@if (Model.Companies != null && Model.Companies.Any())
{
    <div class="unit-card-container" style="margin-bottom:30px;">
        @foreach (var company in Model.Companies)
        {
            <div class="unit-card @(Model.SelectedCompanyId == company.CompanyID ? "selected" : "")">
                <form asp-action="SelectCompany" method="post">
                    <input type="hidden" name="companyId" value="@company.CompanyID" />
                    <button type="submit" class="card-link" style="background:none; border:none; cursor:pointer;">
                        @company.CompanyName
                    </button>
                </form>
            </div>
        }
    </div>
}

<!-- Fiscal Periods - COA Items (Old rpt_ChartOfAccount Repeater) -->
@if (Model.Periods != null && Model.Periods.Any())
{
    <div style="margin-top:20px;">
        <h3 style="font-size:18px; font-weight:600; margin-bottom:15px; color:#1e293b;">Select Fiscal Year / Chart of Account</h3>
        
        @foreach (var period in Model.Periods)
        {
            <div class="coa-item">
                <div class="coa-accent"></div>
                <div class="coa-content">
                    <div class="coa-top">
                        <div>
                            <div class="coa-title">
                                @period.PeriodSetName <span class="year">(@period.PeriodYear)</span>
                            </div>
                            <div class="coa-meta">
                                <span>📅 @period.PeriodTypeName</span>
                                <span>🔢 No: @period.PeriodNumber</span>
                            </div>
                        </div>
                        <div class="coa-tag">@period.Template</div>
                    </div>
                    <div class="coa-info">
                        <div><span class="lbl">Start</span><span class="val">@period.StartDate.ToString("dd MMM yyyy")</span></div>
                        <div><span class="lbl">End</span><span class="val">@period.EndDate.ToString("dd MMM yyyy")</span></div>
                    </div>
                    <div class="coa-bottom">
                        <div class="coa-desc">🧾 @period.COADescription</div>
                        <form asp-action="SelectPeriod" method="post" style="display:inline;">
                            <input type="hidden" name="periodId" value="@period.PeriodID" />
                            <input type="hidden" name="companyId" value="@period.CompanyID" />
                            <input type="hidden" name="fiscalId" value="@period.FiscalID" />
                            <input type="hidden" name="coaId" value="@period.ChartOfAccountID" />
                            <input type="hidden" name="baseCurrencyId" value="@period.BaseCurrencyID" />
                            <button type="submit" class="coa-btn">Proceed →</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (Model.SelectedCompanyId > 0)
{
    <div style="text-align:center; padding:40px; color:#6b7280;">
        No fiscal years found for selected company. Please contact Administrator.
    </div>
}
