@model ERP.Models.WelcomeViewModel
@using System.Globalization
@{
    Layout = "~/Views/Shared/_GeneralLayout.cshtml";
    ViewData["Title"] = "Welcome";

    var inv = CultureInfo.InvariantCulture;
    var userName = User.Identity?.Name ?? "";

    var bizSelected = Model.SelectedBusinessId > 0;
    var unitSelected = bizSelected && Model.SelectedCompanyId > 0;
    int current = !bizSelected ? 1 : (!unitSelected ? 2 : 3);

    var bizName = Model.BusinessList.FirstOrDefault(b => b.BusinessId == Model.SelectedBusinessId)?.BusinessName;
    var unitName = Model.Companies.FirstOrDefault(c => c.CompanyID == Model.SelectedCompanyId)?.CompanyName;

    var stepLabels = new[] { "Business", "Operating Unit", "Fiscal Year" };
    var stepSubs = new[]
    {
        bizSelected && !string.IsNullOrEmpty(bizName) ? bizName : "Choose your business",
        unitSelected && !string.IsNullOrEmpty(unitName) ? unitName : "Choose a unit",
        "Choose a period"
    };
}

<style>
    .wz { max-width: 980px; margin: 0 auto; padding-bottom: 24px; color: var(--ink, #1B1D22); }

    .wz-hero { text-align: center; margin: 8px 0 26px; animation: wzRise .5s cubic-bezier(.16, 1, .3, 1) both; }
    .wz-hero h1 { margin: 0; font-size: 28px; font-weight: 700; letter-spacing: -.02em; }
    .wz-hero p { margin: 6px 0 0; font-size: 13.5px; color: var(--muted, #6B7280); }

    /* Progress */
    .wz-steps { display: flex; align-items: flex-start; justify-content: center; margin: 0 auto 26px; padding: 0; list-style: none; max-width: 720px; animation: wzRise .5s cubic-bezier(.16, 1, .3, 1) .05s both; }
    .wz-step { display: flex; flex-direction: column; align-items: center; text-align: center; width: 150px; flex-shrink: 0; }
    .wz-dot {
        width: 38px; height: 38px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 14px; font-weight: 700;
        background: var(--surface, #fff);
        border: 2px solid var(--line, #E8E6E1);
        color: var(--muted, #6B7280);
        transition: all .3s cubic-bezier(.16, 1, .3, 1);
    }
    .wz-step.done .wz-dot { background: var(--primary); border-color: var(--primary); color: var(--on-primary, #fff); }
    .wz-step.current .wz-dot { border-color: var(--primary); color: var(--primary); box-shadow: 0 0 0 5px color-mix(in srgb, var(--primary) 16%, transparent); transform: scale(1.08); }
    .wz-step b { margin-top: 9px; font-size: 12.5px; font-weight: 600; color: var(--muted, #6B7280); }
    .wz-step.done b, .wz-step.current b { color: var(--ink, #1B1D22); }
    .wz-step small { margin-top: 2px; font-size: 11px; color: var(--muted, #6B7280); max-width: 140px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .wz-line { flex: 1; height: 2px; margin-top: 18px; background: var(--line, #E8E6E1); border-radius: 2px; position: relative; overflow: hidden; min-width: 30px; }
    .wz-line::after { content: ""; position: absolute; inset: 0; background: var(--primary); transform: scaleX(0); transform-origin: left; transition: transform .5s cubic-bezier(.16, 1, .3, 1); }
    .wz-line.done::after { transform: scaleX(1); }

    /* Panels */
    .wz-panel {
        background: var(--surface, #fff);
        border: 1px solid var(--line, #E8E6E1);
        border-radius: var(--radius, 14px);
        padding: 20px 22px;
        margin-bottom: 16px;
        box-shadow: 0 1px 2px rgba(17, 19, 24, .04);
        animation: wzRise .5s cubic-bezier(.16, 1, .3, 1) both;
    }

    .wz-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
    .wz-title { display: flex; align-items: center; gap: 10px; }
    .wz-title i { width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 13px; background: color-mix(in srgb, var(--primary) 12%, transparent); color: var(--primary); }
    .wz-title b { font-size: 11.5px; letter-spacing: .09em; color: var(--ink, #1B1D22); text-transform: uppercase; }
    .wz-count { font-size: 11px; font-weight: 600; color: var(--muted, #6B7280); background: var(--paper, #F8F7F4); border: 1px solid var(--line, #E8E6E1); border-radius: 20px; padding: 3px 10px; white-space: nowrap; }

    /* Business select */
    .wz-select { position: relative; }
    .wz-select > i { position: absolute; top: 50%; transform: translateY(-50%); color: var(--muted, #6B7280); font-size: 13px; pointer-events: none; }
    .wz-select .lead { left: 15px; }
    .wz-select .trail { right: 15px; font-size: 11px; }
    .wz-select select {
        width: 100%; height: 48px;
        padding: 0 40px 0 40px;
        border: 1px solid var(--line, #E8E6E1);
        border-radius: 12px;
        background: var(--paper, #F8F7F4);
        color: var(--ink, #1B1D22);
        font-family: inherit; font-size: 14px; font-weight: 500;
        appearance: none; -webkit-appearance: none;
        outline: 0;
        cursor: pointer;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }
    .wz-select select:hover { border-color: var(--primary); }
    .wz-select select:focus { background: var(--surface, #fff); border-color: var(--primary); box-shadow: 0 0 0 4px color-mix(in srgb, var(--primary) 14%, transparent); }

    /* Operating units */
    .wz-units { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .wz-unit-form { margin: 0; animation: wzRise .45s cubic-bezier(.16, 1, .3, 1) both; }

    .wz-unit {
        position: relative;
        width: 100%;
        display: flex; align-items: center; gap: 12px;
        padding: 14px;
        text-align: left;
        font-family: inherit;
        background: var(--surface, #fff);
        color: var(--ink, #1B1D22);
        border: 1px solid var(--line, #E8E6E1);
        border-radius: var(--radius, 14px);
        cursor: pointer;
        overflow: hidden;
        transition: all .25s cubic-bezier(.16, 1, .3, 1);
    }

    .wz-unit:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0, 0, 0, .06); border-color: var(--primary); }

    .wz-letter {
        width: 40px; height: 40px;
        flex-shrink: 0;
        border-radius: 11px;
        display: flex; align-items: center; justify-content: center;
        font-size: 17px; font-weight: 700;
        background: color-mix(in srgb, var(--primary) 12%, transparent);
        color: var(--primary);
        transition: all .25s cubic-bezier(.16, 1, .3, 1);
    }

    .wz-unit-text { min-width: 0; }
    .wz-unit-text b { display: block; font-size: 13px; font-weight: 600; line-height: 1.25; }
    .wz-unit-text small { display: flex; align-items: center; gap: 6px; margin-top: 4px; font-size: 11px; color: var(--muted, #6B7280); }

    .wz-badge { display: none; font-size: 9.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 2px 7px; border-radius: 10px; background: var(--primary); color: var(--on-primary, #fff); }
    .wz-check { display: none; position: absolute; top: 9px; right: 9px; width: 20px; height: 20px; border-radius: 50%; align-items: center; justify-content: center; font-size: 10px; background: var(--primary); color: var(--on-primary, #fff); }

    .wz-unit.active {
        background: linear-gradient(135deg, #111318 55%, color-mix(in srgb, var(--primary) 38%, #111318));
        color: #fff;
        border-color: #111318;
        box-shadow: inset 4px 0 0 var(--primary), 0 12px 28px color-mix(in srgb, var(--primary) 28%, rgba(0, 0, 0, .25));
        transform: scale(1.02);
    }
    .wz-unit.active:hover { transform: scale(1.02) translateY(-2px); border-color: #111318; }
    .wz-unit.active .wz-letter { background: var(--primary); color: var(--on-primary, #fff); }
    .wz-unit.active small { color: #9CA3AF; }
    .wz-unit.active .wz-badge { display: inline-block; }
    .wz-unit.active .wz-check { display: flex; }

    /* Fiscal years */
    .wz-fiscal {
        display: flex;
        overflow: hidden;
        margin-bottom: 10px;
        background: var(--surface, #fff);
        border: 1px solid var(--line, #E8E6E1);
        border-radius: var(--radius, 14px);
        transition: all .25s cubic-bezier(.16, 1, .3, 1);
        animation: wzRise .45s cubic-bezier(.16, 1, .3, 1) both;
    }
    .wz-fiscal:last-child { margin-bottom: 0; }
    .wz-fiscal:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0, 0, 0, .06); border-color: color-mix(in srgb, var(--primary) 50%, var(--line, #E8E6E1)); }

    .wz-accent { width: 4px; flex-shrink: 0; background: #D1D5DB; transition: background .25s; }
    .wz-fiscal:hover .wz-accent { background: var(--primary); }

    .wz-fiscal-body { flex: 1; min-width: 0; padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .wz-fiscal-name { font-size: 15px; font-weight: 700; }
    .wz-fiscal-name span { font-weight: 500; font-size: 12px; color: var(--muted, #6B7280); margin-left: 4px; }

    .wz-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
    .wz-chip { display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; color: var(--muted, #6B7280); background: var(--paper, #F8F7F4); border: 1px solid var(--line, #E8E6E1); border-radius: 8px; padding: 4px 9px; }
    .wz-chip i { color: var(--primary); font-size: 11px; }
    .wz-chip b { color: var(--ink, #1B1D22); font-weight: 600; }

    .wz-fiscal form { margin: 0; }

    .wz-go {
        display: inline-flex; align-items: center; gap: 8px;
        background: #111318; color: #fff;
        border: 0; border-radius: 8px;
        padding: 8px 16px;
        font-family: inherit; font-size: 12px; font-weight: 600;
        cursor: pointer;
        transition: background .2s, transform .2s, box-shadow .2s;
    }
    .wz-go i { font-size: 11px; transition: transform .25s cubic-bezier(.16, 1, .3, 1); }
    .wz-go:hover { background: var(--primary); color: var(--on-primary, #fff); transform: translateY(-1px); box-shadow: 0 6px 14px color-mix(in srgb, var(--primary) 35%, transparent); }
    .wz-go:hover i { transform: translateX(4px); }

    /* Empty state */
    .wz-empty { text-align: center; padding: 30px 16px; color: var(--muted, #6B7280); }
    .wz-empty i { display: block; font-size: 30px; margin-bottom: 10px; opacity: .45; }
    .wz-empty b { display: block; color: var(--ink, #1B1D22); font-size: 14px; margin-bottom: 4px; }
    .wz-empty span { font-size: 12.5px; }

    @@keyframes wzRise {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 1000px) {
        .wz-units { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 560px) {
        .wz-units { grid-template-columns: 1fr; }
        .wz-hero h1 { font-size: 22px; }
        .wz-step { width: 90px; }
        .wz-step small { display: none; }
        .wz-panel { padding: 16px; }
        .wz-fiscal-body { padding: 14px; }
        .wz-go { width: 100%; justify-content: center; }
        .wz-fiscal form { width: 100%; }
    }
</style>

<div class="wz">
    <div class="wz-hero">
        <h1>Welcome back, @userName</h1>
        <p>Select your business, operating unit and fiscal year to continue to BITWARE ERP</p>
    </div>

    <ol class="wz-steps" aria-label="Progress">
        @for (int i = 1; i <= 3; i++)
        {
            var state = i < current ? "done" : (i == current ? "current" : "todo");
            <li class="wz-step @state" @(i == current ? "aria-current=step" : "")>
                <div class="wz-dot">
                    @if (i < current)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        @i
                    }
                </div>
                <b>@stepLabels[i - 1]</b>
                <small title="@stepSubs[i - 1]">@stepSubs[i - 1]</small>
            </li>
            if (i < 3)
            {
                <li class="wz-line @(i < current ? "done" : "")" aria-hidden="true"></li>
            }
        }
    </ol>

    @* Step 1 *@
    <section class="wz-panel" id="step1">
        <div class="wz-head">
            <div class="wz-title"><i class="fa-solid fa-building"></i><b>Business</b></div>
            <span class="wz-count">Step 1 of 3</span>
        </div>

        @if (Model.BusinessList.Any())
        {
            <form asp-controller="Home" asp-action="ChangeBusiness" method="post">
                <div class="wz-select">
                    <i class="fa-solid fa-magnifying-glass lead"></i>
                    <select name="businessId" aria-label="Business" onchange="this.form.submit()">
                        @if (!bizSelected)
                        {
                            <option value="" selected disabled>Select a business</option>
                        }
                        @foreach (var b in Model.BusinessList)
                        {
                            <option value="@b.BusinessId" selected="@(b.BusinessId == Model.SelectedBusinessId)">@b.BusinessName</option>
                        }
                    </select>
                    <i class="fa-solid fa-chevron-down trail"></i>
                </div>
            </form>
        }
        else
        {
            <div class="wz-empty">
                <i class="fa-regular fa-building"></i>
                <b>No business found</b>
                <span>No business is assigned to your account. Please contact your administrator.</span>
            </div>
        }
    </section>

    @* Step 2 *@
    @if (Model.SelectedBusinessId > 0)
    {
        <section class="wz-panel" id="step2">
            <div class="wz-head">
                <div class="wz-title"><i class="fa-solid fa-sitemap"></i><b>Operating Units</b></div>
                <span class="wz-count">Step 2 of 3 &middot; @Model.Companies.Count @(Model.Companies.Count == 1 ? "unit" : "units")</span>
            </div>

            @if (Model.Companies.Any())
            {
                <div class="wz-units">
                    @for (int i = 0; i < Model.Companies.Count; i++)
                    {
                        var c = Model.Companies[i];
                        var isActive = Model.SelectedCompanyId == c.CompanyID;
                        var letter = string.IsNullOrWhiteSpace(c.CompanyName) ? "?" : c.CompanyName.Trim().Substring(0, 1).ToUpper();
                        <form asp-controller="Home" asp-action="SelectCompany" method="post" class="wz-unit-form" style="animation-delay:@(i * 40)ms">
                            <input type="hidden" name="companyId" value="@c.CompanyID" />
                            <button type="submit" class="wz-unit @(isActive ? "active" : "")" title="@c.CompanyName">
                                <span class="wz-check"><i class="fa-solid fa-check"></i></span>
                                <span class="wz-letter">@letter</span>
                                <span class="wz-unit-text">
                                    <b>@c.CompanyName</b>
                                    <small>ID: @c.CompanyID <span class="wz-badge">Active</span></small>
                                </span>
                            </button>
                        </form>
                    }s
                </div>
            }
            else
            {
                <div class="wz-empty">
                    <i class="fa-solid fa-sitemap"></i>
                    <b>No operating units found</b>
                    <span>There are no operating units assigned to you under this business.</span>
                </div>
            }
        </section>
    }

    @* Step 3 *@
    @if (Model.SelectedBusinessId > 0 && Model.SelectedCompanyId > 0)
    {
        <section class="wz-panel" id="step3">
            <div class="wz-head">
                <div class="wz-title"><i class="fa-solid fa-calendar-days"></i><b>Fiscal Year</b></div>
                <span class="wz-count">Step 3 of 3</span>
            </div>

            @if (Model.Periods.Any())
            {
                var periods = Model.Periods.OrderBy(x => x.StartDate).ToList();
                for (int i = 0; i < periods.Count; i++)
                {
                    var p = periods[i];
                    <div class="wz-fiscal" style="animation-delay:@(i * 50)ms">
                        <div class="wz-accent"></div>
                        <div class="wz-fiscal-body">
                            <div>
                                <div class="wz-fiscal-name">@p.PeriodSetName <span>(@p.PeriodYear)</span></div>
                                <div class="wz-meta">
                                    <span class="wz-chip"><i class="fa-regular fa-calendar"></i>Start <b>@p.StartDate.ToString("dd MMM yyyy", inv)</b></span>
                                    <span class="wz-chip"><i class="fa-regular fa-calendar-check"></i>End <b>@p.EndDate.ToString("dd MMM yyyy", inv)</b></span>
                                    @if (!string.IsNullOrWhiteSpace(p.COADescription))
                                    {
                                        <span class="wz-chip"><i class="fa-solid fa-book"></i>@p.COADescription</span>
                                    }
                                </div>
                            </div>
                            <form asp-controller="Home" asp-action="SelectPeriod" method="post">
                                <input type="hidden" name="periodId" value="@p.PeriodID" />
                                <input type="hidden" name="companyId" value="@p.CompanyID" />
                                <input type="hidden" name="fiscalId" value="@p.FiscalID" />
                                <input type="hidden" name="coaId" value="@p.ChartOfAccountID" />
                                <input type="hidden" name="baseCurrencyId" value="@p.BaseCurrencyID" />
                                <button type="submit" class="wz-go">Proceed <i class="fa-solid fa-arrow-right"></i></button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="wz-empty">
                    <i class="fa-regular fa-calendar-xmark"></i>
                    <b>No fiscal years found</b>
                    <span>No fiscal year is available for this operating unit.</span>
                </div>
            }
        </section>
    }
</div>

<script>
    (function () {
        var key = 'bitWelcomeScroll';

        document.querySelectorAll('.wz-unit-form').forEach(function (f) {
            f.addEventListener('submit', function () {
                try { sessionStorage.setItem(key, '1'); } catch (e) { }
            });
        });

        try {
            if (sessionStorage.getItem(key) === '1') {
                sessionStorage.removeItem(key);
                var target = document.getElementById('step3');
                if (target) {
                    setTimeout(function () { target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 250);
                }
            }
        } catch (e) { }
    })();
</script>
