@model ERP.Models.WelcomeViewModel
@{
    Layout = "~/Views/Shared/_GeneralLayout.cshtml"; ViewData["Title"] = "Welcome";
}
@using System.Globalization
<style>
    .biz-card, .unit-card, .fiscal-card {
        background: #fff;
        border: 1px solid #E8E6E1;
        border-radius: 14px;
        transition: all .2s cubic-bezier(.16,1,.3,1);
    }

        .biz-card:hover, .unit-card:hover, .fiscal-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,.06);
            border-color: #111;
        }

        .unit-card.active {
            background: #111318;
            color: #fff;
            border-color: #111318;
        }

            .unit-card.active small {
                color: #9CA3AF !important;
            }

    .fiscal-card {
        display: flex;
        overflow: hidden;
    }

    .fiscal-accent {
        width: 4px;
        background: #E8E6E1;
    }

    .fiscal-card:hover .fiscal-accent {
        background: var(--bit-teal);
    }
</style>
<div style="max-width:960px;margin:0 auto;">
    <div style="text-align:center;margin:20px 0 24px;">
        <h1 style="font-size:26px;font-weight:700;letter-spacing:-0.02em;">Welcome back, @User.Identity?.Name</h1>
        <p style="color:#5A5F6A;font-size:13px;">Select your company and fiscal year to continue to BITWARE ERP</p>
    </div>

    <div class="biz-card" style="padding:16px 18px;margin-bottom:14px;">
        <div style="display:flex;justify-content:space-between;margin-bottom:8px;"><b style="font-size:11px;color:#6B7280;letter-spacing:.08em;">BUSINESS</b><span style="font-size:10px;color:#9CA3AF;">Step 1 of 3</span></div>
        <form asp-action="ChangeBusiness" method="post">
            <select name="businessId" onchange="this.form.submit()" style="width:100%;height:40px;border-radius:10px;border:1px solid #E8E6E1;padding:0 10px;background:#F8F7F4;">
                @foreach (var b in Model.BusinessList)
                {
                    <option value="@b.BusinessId" selected="@(b.BusinessId == Model.SelectedBusinessId)">@b.BusinessName</option>
                }
            </select>
        </form>
    </div>

    <div class="biz-card" style="padding:16px 18px;margin-bottom:14px;">
        <div style="display:flex;justify-content:space-between;margin-bottom:12px;"><b style="font-size:11px;color:#6B7280;">OPERATING UNITS</b><span style="font-size:10px;color:#9CA3AF;">@Model.Companies.Count units</span></div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px;">
            @foreach (var c in Model.Companies)
            {
                <form asp-action="SelectCompany" method="post">
                    <input type="hidden" name="companyId" value="@c.CompanyID" />
                    <button class="unit-card @(Model.SelectedCompanyId == c.CompanyID ? "active" : "")" style="width:100%;text-align:left;padding:10px 12px;display:flex;gap:10px;align-items:center;">
                        <span style="width:30px;height:30px;background:#fff;border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--bit-teal);">@c.CompanyName.Substring(0, 1)</span>
                        <span><b style="font-size:12px;display:block;">@c.CompanyName</b><small style="font-size:10px;color:#6B7280;">ID: @c.CompanyID • Active</small></span>
                    </button>
                </form>
            }
        </div>
    </div>

    @if (Model.Periods.Any())
    {
        <div class="biz-card" style="padding:16px 18px;">
            <div style="display:flex;justify-content:space-between;margin-bottom:12px;"><b style="font-size:11px;color:#6B7280;">FISCAL YEAR</b><span style="font-size:10px;color:#9CA3AF;">Select to proceed</span></div>
            @foreach (var p in Model.Periods.OrderBy(x => x.StartDate))
            {
                <div class="fiscal-card" style="margin-bottom:10px;">
                    <div class="fiscal-accent"></div>
                    <div style="flex:1;padding:12px 14px;display:flex;justify-content:space-between;align-items:center;">
                        <div>
                            <div style="font-weight:700;font-size:13px;">@p.PeriodSetName <span style="font-weight:400;color:#6B7280;font-size:11px;">(@p.PeriodYear)</span></div>
                            <div style="font-size:11px;color:#6B7280;margin-top:2px;">Start <b style="color:#111;">@p.StartDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</b> &nbsp; End <b style="color:#111;">@p.EndDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</b> &nbsp; 🧾 @p.COADescription</div>
                        </div>
                        <form asp-action="SelectPeriod" method="post">
                            <input type="hidden" name="periodId" value="@p.PeriodID" /><input type="hidden" name="companyId" value="@p.CompanyID" /><input type="hidden" name="fiscalId" value="@p.FiscalID" /><input type="hidden" name="coaId" value="@p.ChartOfAccountID" /><input type="hidden" name="baseCurrencyId" value="@p.BaseCurrencyID" />
                            <button style="background:#111;color:#fff;border:none;border-radius:8px;padding:7px 14px;font-size:12px;font-weight:600;">Proceed →</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>