<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BITWARE ERP</title>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --bit-teal: #0E7A8A;
            --bit-paper: #F8F7F4;
            --bit-line: #E8E6E1;
            --bit-sidebar: #111318;
            --bit-sidebar-2: #1C1F26;
        }

        * {
            font-family: 'Instrument Sans',sans-serif;
        }

        body {
            background: var(--bit-paper);
            margin: 0;
        }

        .bit-topbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 64px;
            background: #fff;
            border-bottom: 1px solid var(--bit-line);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            z-index: 1050;
        }

        .bit-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .bit-logo {
            width: 36px;
            height: 36px;
            background: var(--bit-sidebar);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 800;
        }

        .bit-brand b {
            font-size: 16px;
            color: #1A1D23;
        }

        .bit-brand small {
            display: block;
            font-size: 9px;
            letter-spacing: .15em;
            color: #6B7280;
            font-weight: 700;
        }

        .bit-company {
            display: flex;
            align-items: center;
            gap: 8px;
            border-left: 1px solid var(--bit-line);
            padding-left: 12px;
            margin-left: 10px;
            font-size: 12px;
            color: #6B7280;
        }

        .dot {
            width: 7px;
            height: 7px;
            background: var(--bit-teal);
            border-radius: 50%;
        }

        .bit-search {
            display: flex;
            align-items: center;
            background: var(--bit-paper);
            border: 1px solid var(--bit-line);
            border-radius: 999px;
            padding: 0 14px;
            height: 38px;
            width: 360px;
        }

            .bit-search input {
                border: none;
                background: transparent;
                outline: none;
                width: 100%;
                font-size: 13px;
            }

        .bit-sidebar {
            width: 270px;
            min-width: 270px;
            background: var(--bit-sidebar);
            min-height: calc(100vh - 64px);
            position: sticky;
            top: 64px;
            padding: 16px 10px;
            overflow-y: auto;
        }

        .menu-label {
            color: #6B7280;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            padding: 16px 10px 6px;
        }

        #navbar {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            #navbar > li > a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 10px;
                border-radius: 10px;
                color: #9CA3AF;
                font-size: 13px;
                font-weight: 500;
                text-decoration: none;
                transition: all .2s;
            }

                #navbar > li > a:hover {
                    background: var(--bit-sidebar-2);
                    color: #E5E7EB;
                    transform: translateX(2px);
                }

            #navbar > li.active > a {
                background: #fff;
                color: #111;
            }

            #navbar .child_menu {
                list-style: none;
                padding-left: 24px;
                margin: 4px 0 6px;
                display: none;
            }

                #navbar .child_menu li a {
                    padding: 6px 10px;
                    font-size: 12px;
                    color: #6B7280;
                    border-left: 1px solid #252932;
                    display: block;
                    text-decoration: none;
                }

                    #navbar .child_menu li a:hover {
                        color: #E5E7EB;
                        border-left-color: var(--bit-teal);
                    }

            #navbar .fa-chevron-down {
                margin-left: auto;
                font-size: 9px;
                opacity: .5;
                transition: .2s;
            }

            #navbar li.active .fa-chevron-down {
                transform: rotate(180deg);
            }

        .bit-main {
            flex: 1;
            min-width: 0;
            padding: 24px;
        }

        .bit-content {
            animation: rise .35s;
        }
        @@keyframes

        rise {
            from

        {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .profile-dropdown {
            position: relative;
        }

        .profile-menu {
            position: absolute;
            top: 44px;
            right: 0;
            background: #fff;
            border: 1px solid #E8E6E1;
            border-radius: 12px;
            min-width: 200px;
            box-shadow: 0 10px 30px rgba(0,0,0,.12);
            display: none;
            z-index: 2000;
            padding: 6px;
        }

            .profile-menu a {
                display: flex;
                gap: 10px;
                padding: 9px 12px;
                border-radius: 8px;
                color: #111;
                font-size: 12px;
                text-decoration: none;
            }

                .profile-menu a:hover {
                    background: #F8F7F4;
                }

        .bit-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #111;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
        }
    </style>
    @RenderSection("HeadContent", required: false)
</head>
<body>
    <div class="bit-topbar" id="dvtop">
        <div style="display:flex;align-items:center;">
            <a href="javascript:;" id="menu_toggle" style="margin-right:12px;color:#111;"><i class="fa fa-bars"></i></a>
            <a href="/Home/Welcome" class="bit-brand"><div class="bit-logo">B</div><div><b>BITWARE ERP</b><small>ENTERPRISE OS • GENERAL</small></div></a>
            <div class="bit-company"><span class="dot"></span>General Area</div>
        </div>
        <div style="display:flex;align-items:center;gap:14px;">
            <div class="bit-search"><i class="fa fa-search" style="color:#9CA3AF;margin-right:8px;"></i><input type="text" id="txtMenuSearch" placeholder="Search menu... press /" /></div>
            <div class="profile-dropdown">
                <div class="bit-avatar" id="profileBtn">@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")</div>
                <div class="profile-menu" id="profileMenu">
                    <div style="padding:8px 12px;border-bottom:1px solid #F0F0F0;margin-bottom:4px;">
                        <div style="font-size:13px;font-weight:600;">@User.Identity?.Name</div>
                        <div style="font-size:11px;color:#6B7280;">General Access • admin</div>
                    </div>
                    <a href="/Home/Welcome"><i class="fa fa-rotate" style="width:18px;"></i> Change Company</a>
                    <a href="/Account/Logout"><i class="fa fa-right-from-bracket" style="width:18px;"></i> Logout</a>
                </div>
            </div>
        </div>
    </div>
    <div id="topnav" style="display:none;"><div id="oldnavbarmenu"></div></div>
    <div id="topdiv" style="display:none;"></div>

    <div style="display:flex;padding-top:64px;">
        <div class="bit-sidebar" id="dvleft">
            <div class="menu-label">General Navigation</div>
            <ul id="navbar">
                @if (ViewBag.GeneralMenus != null)
                {
                    foreach (var m in ViewBag.GeneralMenus)
                    {
                        <li class="@(m.Name == "Welcome" ? "active" : "")">
                            <a href="@(m.Path == "#" ? "javascript:;" : m.Path)" class="@(m.Children.Count > 0 ? "parent" : "")">
                                <i class="@m.Icon"></i><span class="searchlist">@m.Name</span>@if(m.Children.Count>0){
                                <span class="fa fa-chevron-down"></span>
                            }
                        </a>
                        @if (m.Children.Count > 0)
                        {
                            <ul class="child_menu">@foreach(var c in m.Children){
                            <li><a href="@(c.Path == "#" ? "javascript:;" : c.Path)"><span class="searchlist">@c.Name</span></a></li>
                        }
    </ul>
                    }
                </li>
                                }
                                }
                                else
                {
                    <li><a href="/Home/Welcome"><i class="fa fa-house"></i><span class="searchlist">Welcome</span></a></li>
                }
            </ul>
        </div>
        <div class="bit-main" id="dvmain">
            <div id="div_message" class="alert alert-warning" style="display:none;"></div>
            <div id="PageDisplay" class="bit-content">@RenderBody()</div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleBitMenu(el){var li=el.closest('li');var ch=li.querySelector('ul.child_menu');if(ch){ch.style.display=ch.style.display==='block'?'none':'block';li.classList.toggle('active');}}
        $("#navbar").on("click","li > a.parent",function(e){e.preventDefault();toggleBitMenu(this);});
        $("#txtMenuSearch").on("keyup input",function(){var q=$(this).val().toLowerCase().trim();if(!q){$("#navbar > li").show();$(".child_menu").hide();return;} $("#navbar > li").each(function(){var rt=$(this).children('a').text().toLowerCase();var has=false;$(this).find('.child_menu li').each(function(){var t=$(this).text().toLowerCase();if(t.indexOf(q)!==-1){$(this).show();has=true;}else{$(this).hide();}});if(rt.indexOf(q)!==-1||has){$(this).show();$(this).find('.child_menu').show();$(this).addClass('active');}else{$(this).hide();}});});
        $("#profileBtn").on("click",function(e){e.stopPropagation();$("#profileMenu").toggle();}); $(document).on("click",function(){ $("#profileMenu").hide(); });
        $(document).on('keydown',function(e){if(e.key==='/'&&!$(e.target).is('input,textarea')){e.preventDefault();$("#txtMenuSearch").focus();}});
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>